<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>HanJaeJoon</Authors>
    <Description>3D convex hull of a point cloud using the QuickHull algorithm. A C# port of akuukka/quickhull.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HanJaeJoon/QuickHullSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HanJaeJoon/QuickHullSharp.git</RepositoryUrl>
    <PackageTags>QuickHull, ConvexHull, Convex Hull, 3D, Geometry, CSharp, .NET</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) HanJaeJoon</Copyright>
    <PackageReleaseNotes>See https://github.com/HanJaeJoon/QuickHullSharp/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>

    <!-- SourceLink: lets package consumers step into the GitHub sources while debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the types newer C# features need on netstandard at compile time (no runtime dependency) -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" Condition="$(TargetFramework.StartsWith('netstandard'))" />
    <!-- netstandard2.0 (.NET Framework) has no System.Numerics.Vector3 -->
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- netstandard2.0 has no Span<T>/ReadOnlySpan<T> (inbox from 2.1) -->
    <PackageReference Include="System.Memory" Version="4.6.3" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests check internal helpers (Plane, MathUtils) directly -->
    <InternalsVisibleTo Include="QuickHullSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
